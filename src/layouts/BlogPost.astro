---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  keywords?: string[];
  heroImage?: string;
}

const { title, description, pubDate, keywords = [], heroImage } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — INDUC TECH</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    {heroImage && <meta property="og:image" content={heroImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        --navy: #0e1a2e;
        --navy-light: #1a2744;
        --blue: #2563eb;
        --blue-bright: #3b82f6;
        --blue-steel: #2b6cb0;
        --text: #e2e8f0;
        --text-muted: #94a3b8;
        --border: #1e3560;
        --surface: #131f38;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', sans-serif;
        background: var(--navy);
        color: var(--text);
        line-height: 1.75;
      }
      /* HEADER */
      header {
        background: var(--navy-light);
        border-bottom: 1px solid var(--border);
        padding: 0 2rem;
      }
      .header-inner {
        max-width: 860px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 80px;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text);
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: 0.05em;
      }
      .logo-img {
        height: 140px;
        width: auto;
        filter: brightness(0) invert(1);
        margin: -28px 0;
      }
      nav a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.875rem;
        margin-left: 1.5rem;
        transition: color 0.2s;
      }
      nav a:hover { color: var(--blue); }
      /* HERO IMAGE */
      .hero-wrap {
        max-width: 860px;
        margin: 2rem auto 0;
        padding: 0 2rem;
      }
      .hero-img {
        width: 100%;
        max-height: 380px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--border);
      }
      /* ARTICLE */
      .article-wrap {
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem 2rem 4rem;
      }
      .article-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
      }
      .tag {
        background: rgba(37, 99, 235, 0.15);
        color: var(--blue-bright);
        border: 1px solid rgba(37, 99, 235, 0.35);
        padding: 0.2rem 0.7rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .date {
        color: var(--text-muted);
        font-size: 0.875rem;
      }
      h1 {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.25;
        color: #f1f5f9;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      /* CONTENT */
      .content h2 {
        font-size: 1.35rem;
        font-weight: 600;
        color: #f1f5f9;
        margin: 2.5rem 0 1rem;
        padding-left: 0.75rem;
        border-left: 3px solid var(--blue-bright);
      }
      .content h3 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text);
        margin: 1.5rem 0 0.75rem;
      }
      .content p {
        margin-bottom: 1.25rem;
        color: #cbd5e1;
        font-size: 0.975rem;
      }
      .content strong { color: #f1f5f9; font-weight: 600; }
      .content a { color: var(--blue); }
      .content ul, .content ol {
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
        color: #cbd5e1;
        font-size: 0.975rem;
      }
      .content li { margin-bottom: 0.4rem; }
      /* TABLE */
      .content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.9rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
      }
      .content th {
        background: var(--surface);
        color: var(--blue);
        font-weight: 600;
        padding: 0.75rem 1rem;
        text-align: left;
        border-bottom: 1px solid var(--border);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .content td {
        padding: 0.7rem 1rem;
        border-bottom: 1px solid rgba(30, 58, 95, 0.5);
        color: #cbd5e1;
      }
      .content tr:last-child td { border-bottom: none; }
      .content tr:hover td { background: rgba(14, 165, 233, 0.04); }
      /* CODE */
      .content code {
        font-family: 'JetBrains Mono', monospace;
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--blue);
        padding: 0.15em 0.45em;
        border-radius: 4px;
        font-size: 0.85em;
      }
      .content pre {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1.25rem;
        overflow-x: auto;
        margin: 1.5rem 0;
      }
      .content pre code {
        background: none;
        border: none;
        color: #e2e8f0;
        padding: 0;
        font-size: 0.875rem;
      }
      /* INLINE IMAGES */
      .content img {
        width: 100%;
        border-radius: 6px;
        border: 1px solid var(--border);
        margin: 1.5rem 0;
        display: block;
      }
      .content img + em {
        display: block;
        text-align: center;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: -1rem;
        margin-bottom: 1.5rem;
      }
      /* FOOTER */
      footer {
        border-top: 1px solid var(--border);
        padding: 2rem;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.8rem;
      }
      footer a { color: var(--blue); text-decoration: none; }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo">
          <img class="logo-img" src="/logo-training.png" alt="INDUCTECH TRAINING" />
        </a>
        <nav>
          <a href="/">Inicio</a>
          <a href="/blog">Blog</a>
          <a href="https://www.inductech.cl" target="_blank">Web</a>
        </nav>
      </div>
    </header>

    {heroImage && (
      <div class="hero-wrap">
        <img class="hero-img" src={heroImage} alt={title} />
      </div>
    )}

    <div class="article-wrap">
      <div class="article-meta">
        <span class="tag">Ingeniería Eléctrica</span>
        <span class="date">{formattedDate}</span>
      </div>
      <h1>{title}</h1>
      <div class="content">
        <slot />
      </div>
    </div>

    <footer>
      <p>© 2026 <a href="https://www.inductech.cl">INDUC TECH</a> — Ingeniería Eléctrica · Minería e Industria</p>
    </footer>
  </body>
</html>
