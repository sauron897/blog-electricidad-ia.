---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  keywords?: string[];
  heroImage?: string;
}

const { title, description, pubDate, keywords = [], heroImage } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={Astro.url} />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    {heroImage && <meta property="og:image" content={heroImage} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <style>
      body {
        font-family: Georgia, serif;
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 1rem;
        color: #222;
        line-height: 1.7;
      }
      .hero { width: 100%; max-height: 400px; object-fit: cover; border-radius: 6px; margin-bottom: 1.5rem; }
      h1 { font-size: 2rem; line-height: 1.2; }
      h2 { font-size: 1.4rem; margin-top: 2rem; }
      a { color: #0066cc; }
      nav { margin-bottom: 2rem; }
      nav a { margin-right: 1rem; text-decoration: none; font-family: sans-serif; font-size: 0.9rem; }
      .meta { color: #666; font-size: 0.9rem; font-family: sans-serif; margin-bottom: 2rem; }
      code { background: #f4f4f4; padding: 0.1em 0.4em; border-radius: 3px; font-size: 0.9em; }
      pre { background: #f4f4f4; padding: 1rem; overflow-x: auto; border-radius: 4px; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Inicio</a>
      <a href="/blog">Blog</a>
    </nav>
    <article>
      {heroImage && <img class="hero" src={heroImage} alt={title} />}
      <h1>{title}</h1>
      <p class="meta">Publicado el {formattedDate}</p>
      <slot />
    </article>
  </body>
</html>
